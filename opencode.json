{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia-nim/nvidia/nemotron-3.5-super-vl-120b-a12b",
  "small_model": "nvidia-nim/nvidia/nemotron-3.5-super-vl-120b-a12b",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20480
  },
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push*main*": "deny",
      "git push*master*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny",
      ".agents/skills/agentloop-*/**": "deny"
    }
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "/opt/graphify/bin/python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      }
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "SEARXNG_URL": "http://host.docker.internal:8080"
      }
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 600000,
        "setCacheKey": true
      },
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": { "order": ["deepinfra"], "allow_fallbacks": true }
          }
        },
        "xiaomi/mimo-v2.6-flash": {
          "options": {
            "provider": { "order": ["makora"], "allow_fallbacks": true }
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://host.docker.internal:1234/v1"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen3.8 27B (local)"
        }
      }
    },
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "nvidia/nemotron-3.5-super-vl-120b-a12b": {
          "name": "Nemotron 3.5 Super VL 120B A12B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1000000, "output": 16384 }
        }
      }
    }    
  }
}
